---
// Replaces Starlight's search with the finder (docs, shortcuts, commands, manual).
import Finder from './Finder.astro';
---

<button type="button" class="open" data-open-finder aria-label="Search">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
  <span class="text">Search docs, keys, commands</span>
  <kbd class="k">Ctrl K</kbd>
</button>
<dialog data-finder-dialog aria-label="Search">
  <Finder compact />
</dialog>

<style>
  .open {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--sk-line);
    border-radius: 9px;
    background: var(--sk-bg-2);
    color: var(--sk-muted);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .open:hover {
    border-color: var(--sk-blue);
    color: var(--sk-fg);
  }
  .text {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 50rem) {
    .text,
    .k {
      display: none;
    }
    .open {
      width: auto;
      border: 0;
      background: none;
    }
  }
  dialog {
    width: min(48rem, calc(100vw - 2rem));
    margin: 10vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  dialog::backdrop {
    background: rgb(10 10 18 / 0.6);
    backdrop-filter: blur(3px);
  }
</style>
