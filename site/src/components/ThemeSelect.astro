---
// Dark by default; one button flips to light and back (remembered).
---

<button type="button" class="theme" data-theme-toggle aria-label="Switch between dark and light">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
</button>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {}
    });
  }
</script>

<style>
  .theme {
    display: flex;
    padding: 0.4rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--sl-color-white);
  }
  .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  :global([data-theme='light']) .sun {
    display: block;
  }
</style>
