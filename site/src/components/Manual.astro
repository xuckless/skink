---
// One manual topic (a section of help.txt), as rich text.
import { parseManual, inline } from '../lib/manual';
interface Props { body: string }
const blocks = parseManual(Astro.props.body);
---

<section class="man">
  {
    blocks.map((b) =>
      b.type === 'p' ? (
        <p set:html={inline(b.text)} />
      ) : b.type === 'code' ? (
        <pre class="code"><code>{b.lines.join('\n')}</code></pre>
      ) : (
        <dl>
          {b.items.map((it) => (
            <div class="row">
              <dt set:html={inline(it.term)} />
              <dd>
                <span set:html={inline(it.desc.join(' '), true)} />
                {it.code.length > 0 && (
                  <pre class="code">
                    <code>{it.code.join('\n')}</code>
                  </pre>
                )}
              </dd>
            </div>
          ))}
        </dl>
      ),
    )
  }
</section>

<style>
  .man dl {
    margin: 1.25rem 0 1.75rem;
  }
  .man .row {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    gap: 0.3rem 1.5rem;
    padding: 0.7rem 0;
    margin: 0;
  }
  .man .row + .row {
    box-shadow: 0 -1px 0 var(--sk-line-soft);
  }
  .man dt {
    margin: 0;
    font-weight: 600;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .man dd {
    margin: 0;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    min-width: 0;
  }
  .man :global(.plus) {
    color: var(--sk-muted);
    margin: 0 0.12rem;
    font-size: 0.8em;
  }
  .man :global(code.cmd) {
    color: var(--sk-purple);
  }
  .man pre.code {
    margin: 0.6rem 0 0;
    padding: 0.75rem 0.95rem;
    border-radius: 8px;
    background: var(--sk-bg-2);
    font-size: 0.82rem;
    overflow-x: auto;
    max-width: 100%;
  }
  @media (max-width: 40rem) {
    .man .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
