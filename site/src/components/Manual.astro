---
// One manual topic: a :help page (crates/skink-ui/src/help/*.md) rendered
// with the docs' own prose styles.
import { manualHtml } from '../lib/manual';
interface Props { body: string }
const html = await manualHtml(Astro.props.body);
---

<section class="man" set:html={html} />

<style>
  .man :global(.plus) {
    color: var(--sk-muted);
    margin: 0 0.12rem;
    font-size: 0.8em;
  }
  .man :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  .man :global(td:first-child) {
    white-space: nowrap;
  }
  .man :global(pre) {
    padding: 0.75rem 0.95rem;
    border-radius: 8px;
    background: var(--sk-bg-2);
    font-size: 0.82rem;
    overflow-x: auto;
    max-width: 100%;
  }
</style>
