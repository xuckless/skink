---
// Real Skink sessions, recorded in a pty by scripts/record.py, replayed with
// asciinema-player. Captions are asciicast markers.
import casts from '../../public/casts/version.json';
const demos = [
  { id: 'edit', label: 'Edit', blurb: 'Open a folder, quick open, type, multiple cursors, save.' },
  { id: 'find', label: 'Find & replace', blurb: 'Find as you type, replace all, search the project.' },
  { id: 'terminal', label: 'Terminal', blurb: 'A real shell in a tab, one key away from your file.' },
  { id: 'panes', label: 'Panes & zoom', blurb: 'Split, show hidden files, hide the tree, zoom, help.' },
  { id: 'exit', label: 'Quit', blurb: 'Ctrl+Q quits. Unsaved work? It asks first.' },
];
---

<section class="demo" data-demo>
  <div class="tabs" role="tablist" aria-label="Demos">
    {
      demos.map((d, i) => (
        <button type="button" role="tab" aria-selected={i === 0} data-cast={d.id} data-blurb={d.blurb}>
          {d.label}
        </button>
      ))
    }
  </div>
  <div class="frame">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>skink — ~/forecast</span></div>
    <div class="player" data-player role="img" aria-label="Recording of Skink running in a terminal"></div>
    <div class="caption" aria-live="polite" data-caption><span class="blurb">{demos[0].blurb}</span></div>
  </div>
  <p class="note">
    Recorded from the real Skink {casts.version} binary in a terminal, not a mock-up. A live editor you can type in,
    right here in the browser, is next (WebAssembly; nothing you type would be saved).
  </p>
</section>

<script>
  import 'asciinema-player/dist/bundle/asciinema-player.css';

  const BASE = '/skink/casts/';
  type Player = { dispose(): void; play(): Promise<void>; addEventListener(e: string, f: (ev: any) => void): void };

  const fmt = (label: string) => {
    const at = label.indexOf('  ');
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
    if (at < 0) return `<span class="txt">${esc(label)}</span>`;
    const keys = label.slice(0, at);
    const rest = label.slice(at + 2);
    const chip = keys
      .split(/(\+)/)
      .map((p) => (p === '+' ? '<span class="plus">+</span>' : `<kbd>${esc(p)}</kbd>`))
      .join('');
    return `<span class="keys">${chip}</span><span class="txt">${esc(rest)}</span>`;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const host = root.querySelector<HTMLElement>('[data-player]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-cast]')];
    let player: Player | null = null;
    let lib: typeof import('asciinema-player') | null = null;

    const load = async (tab: HTMLButtonElement, autoPlay: boolean) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      caption.innerHTML = `<span class="blurb">${tab.dataset.blurb}</span>`;
      lib ??= await import('asciinema-player');
      player?.dispose();
      host.innerHTML = '';
      player = lib.create(BASE + tab.dataset.cast + '.cast', host, {
        cols: 110,
        rows: 30,
        autoPlay,
        loop: true,
        preload: true,
        fit: 'width',
        idleTimeLimit: 2,
        theme: 'skink',
        terminalFontFamily: "'JetBrains Mono', 'Symbols Nerd Font Mono', ui-monospace, Menlo, Consolas, monospace",
        terminalLineHeight: 1.2,
        controls: true,
      }) as Player;
      player.addEventListener('marker', ({ label }: { label: string }) => {
        caption.innerHTML = fmt(label);
      });
    };

    tabs.forEach((t) => t.addEventListener('click', () => load(t, true)));
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void load(tabs[0], !matchMedia('(prefers-reduced-motion: reduce)').matches);
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  }
</script>

<style>
  .demo {
    width: 100%;
  }
  .tabs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    padding-bottom: 0.6rem;
    scrollbar-width: none;
  }
  .tabs button {
    flex: none;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--sk-line);
    background: transparent;
    color: var(--sk-fg-2);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--sk-blue);
    border-color: var(--sk-blue);
    color: #16161e;
    font-weight: 600;
  }
  .frame {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #292e42;
    background: #16161e;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(122 162 247 / 0.06);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    background: #1a1b26;
    border-bottom: 1px solid #292e42;
    font-size: 0.78rem;
    color: #737aa2;
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3b4261;
  }
  .chrome span {
    margin-left: 0.6rem;
    font-family: var(--sk-mono);
  }
  .player {
    background: #16161e;
  }
  .caption {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.6rem 1rem;
    background: #1a1b26;
    border-top: 1px solid #292e42;
    color: #c0caf5;
    font-size: 0.95rem;
  }
  .caption :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex: none;
  }
  .caption :global(kbd) {
    background: #24283b;
    border-color: #3b4261;
    color: #c0caf5;
  }
  .caption :global(.plus) {
    color: #737aa2;
  }
  .caption :global(.blurb) {
    color: #a9b1d6;
  }
  .note {
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--sk-muted);
  }
  :global(.asciinema-player-theme-skink) {
    --term-color-foreground: #c0caf5;
    --term-color-background: #16161e;
    --term-color-0: #15161e;
    --term-color-1: #f7768e;
    --term-color-2: #9ece6a;
    --term-color-3: #e0af68;
    --term-color-4: #7aa2f7;
    --term-color-5: #bb9af7;
    --term-color-6: #7dcfff;
    --term-color-7: #a9b1d6;
    --term-color-8: #414868;
    --term-color-9: #f7768e;
    --term-color-10: #9ece6a;
    --term-color-11: #e0af68;
    --term-color-12: #7aa2f7;
    --term-color-13: #bb9af7;
    --term-color-14: #7dcfff;
    --term-color-15: #c0caf5;
  }
  .player :global(.ap-wrapper) {
    background: #16161e;
  }
</style>
