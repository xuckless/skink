---
// Real Skink sessions, recorded in a pty by scripts/record.py, replayed with
// asciinema-player. Captions are asciicast markers; mouse demos also have a
// pointer track (<id>.ptr.json) drawn over the terminal.
import version from '../../public/casts/version.json';
import { CASTS, HOME } from '../data/demos';
interface Props {
  casts?: string[];
  compact?: boolean;
}
const { casts = HOME, compact = false } = Astro.props;
const demos = casts.map((id) => CASTS[id]).filter(Boolean);
---

<section class:list={['demo', { compact }]} data-demo>
  {
    demos.length > 1 && (
      <div class="tabs" role="tablist" aria-label="Demos">
        {demos.map((d, i) => (
          <button type="button" role="tab" aria-selected={i === 0} data-cast={d.id} data-blurb={d.blurb} data-ptr={d.pointer ? '1' : undefined}>
            {d.label}
          </button>
        ))}
      </div>
    )
  }
  {demos.length === 1 && <button hidden data-cast={demos[0].id} data-blurb={demos[0].blurb} data-ptr={demos[0].pointer ? '1' : undefined} />}
  <div class="frame">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>skink — ~/forecast</span></div>
    <div class="player" data-player role="img" aria-label={`Recording of Skink: ${demos[0]?.blurb ?? ''}`}></div>
    <div class="caption" aria-live="polite" data-caption><span class="blurb">{demos[0]?.blurb}</span></div>
  </div>
  {
    !compact && (
      <p class="note">
        Recorded from the real Skink {version.version} binary in a terminal, not a mock-up. A live editor you can
        type in, right here in the browser, is next (WebAssembly; nothing you type would be saved).
      </p>
    )
  }
</section>

<script>
  import 'asciinema-player/dist/bundle/asciinema-player.css';

  const BASE = '/skink/casts/';
  type Player = {
    dispose(): void;
    getCurrentTime(): number | Promise<number>;
    addEventListener(e: string, f: (ev: any) => void): void;
  };
  type Ptr = { cols: number; rows: number; track: [number, number, number, string][] };

  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  const fmt = (label: string) => {
    const at = label.indexOf('  ');
    if (at < 0) return `<span class="txt">${esc(label)}</span>`;
    const chip = label
      .slice(0, at)
      .split(/(\+)/)
      .map((p) => (p === '+' ? '<span class="plus">+</span>' : `<kbd>${esc(p)}</kbd>`))
      .join('');
    return `<span class="keys">${chip}</span><span class="txt">${esc(label.slice(at + 2))}</span>`;
  };

  const POINTER =
    '<svg viewBox="0 0 16 22" width="16" height="22" aria-hidden="true"><path d="M1 1v17l4.5-4.2 3 6.6 3-1.4-3-6.4H15z" fill="#fff" stroke="#16161e" stroke-width="1.4" stroke-linejoin="round"/></svg><span class="ring"></span>';

  for (const root of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const host = root.querySelector<HTMLElement>('[data-player]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-cast]')];
    let player: Player | null = null;
    let lib: typeof import('asciinema-player') | null = null;
    let raf = 0;

    const follow = (ptr: Ptr) => {
      const el = document.createElement('div');
      el.className = 'pointer';
      el.innerHTML = POINTER;
      host.appendChild(el);
      const tick = async () => {
        const p = player;
        if (!p) return;
        const now = await p.getCurrentTime();
        const term = host.querySelector<HTMLElement>('.ap-term');
        let last = null;
        for (const e of ptr.track) {
          if (e[0] > now) break;
          last = e;
        }
        if (term && last) {
          const tr = term.getBoundingClientRect();
          const hr = host.getBoundingClientRect();
          const cw = tr.width / ptr.cols;
          const ch = tr.height / ptr.rows;
          el.style.opacity = '1';
          el.style.transform = `translate(${tr.left - hr.left + (last[1] - 0.5) * cw}px, ${tr.top - hr.top + (last[2] - 0.6) * ch}px)`;
          el.classList.toggle('down', (last[3] === 'press' || last[3] === 'drag') && now - last[0] < 0.5);
        } else {
          el.style.opacity = '0';
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    const load = async (tab: HTMLButtonElement, autoPlay: boolean) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      caption.innerHTML = `<span class="blurb">${esc(tab.dataset.blurb ?? '')}</span>`;
      lib ??= await import('asciinema-player');
      cancelAnimationFrame(raf);
      player?.dispose();
      host.innerHTML = '';
      const id = tab.dataset.cast!;
      player = lib.create(BASE + id + '.cast', host, {
        cols: 110,
        rows: 30,
        autoPlay,
        loop: true,
        preload: true,
        fit: 'width',
        theme: 'skink',
        terminalFontFamily: "'JetBrains Mono', 'Symbols Nerd Font Mono', ui-monospace, Menlo, Consolas, monospace",
        terminalLineHeight: 1.2,
        controls: true,
      }) as Player;
      player.addEventListener('marker', ({ label }: { label: string }) => {
        caption.innerHTML = fmt(label);
      });
      if (tab.dataset.ptr) fetch(BASE + id + '.ptr.json')
        .then((r) => (r.ok ? r.json() : null))
        .then((ptr: Ptr | null) => ptr && follow(ptr))
        .catch(() => {});
    };

    tabs.forEach((t) => t.addEventListener('click', () => load(t, true)));
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void load(tabs[0], !matchMedia('(prefers-reduced-motion: reduce)').matches);
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  }
</script>

<style>
  .demo {
    width: 100%;
  }
  .tabs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    padding-bottom: 0.6rem;
    scrollbar-width: none;
  }
  .tabs button {
    flex: none;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--sk-line);
    background: transparent;
    color: var(--sk-fg-2);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--sk-blue);
    border-color: var(--sk-blue);
    color: #16161e;
    font-weight: 600;
  }
  .frame {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #292e42;
    background: #16161e;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(122 162 247 / 0.06);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    background: #1a1b26;
    border-bottom: 1px solid #292e42;
    font-size: 0.78rem;
    color: #737aa2;
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3b4261;
  }
  .chrome span {
    margin-left: 0.6rem;
    font-family: var(--sk-mono);
  }
  .player {
    background: #16161e;
  }
  .caption {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.6rem 1rem;
    background: #1a1b26;
    border-top: 1px solid #292e42;
    color: #c0caf5;
    font-size: 0.95rem;
  }
  .caption :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex: none;
  }
  .caption :global(kbd) {
    background: #24283b;
    border-color: #3b4261;
    color: #c0caf5;
  }
  .caption :global(.plus) {
    color: #737aa2;
  }
  .caption :global(.blurb) {
    color: #a9b1d6;
  }
  .note {
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--sk-muted);
  }
  :global(.asciinema-player-theme-skink) {
    --term-color-foreground: #c0caf5;
    --term-color-background: #16161e;
    --term-color-0: #15161e;
    --term-color-1: #f7768e;
    --term-color-2: #9ece6a;
    --term-color-3: #e0af68;
    --term-color-4: #7aa2f7;
    --term-color-5: #bb9af7;
    --term-color-6: #7dcfff;
    --term-color-7: #a9b1d6;
    --term-color-8: #414868;
    --term-color-9: #f7768e;
    --term-color-10: #9ece6a;
    --term-color-11: #e0af68;
    --term-color-12: #7aa2f7;
    --term-color-13: #bb9af7;
    --term-color-14: #7dcfff;
    --term-color-15: #c0caf5;
  }
  .player {
    position: relative;
  }
  .player :global(.pointer) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: transform 0.28s ease, opacity 0.2s;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }
  .player :global(.pointer .ring) {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #ff9e64;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.15s, transform 0.15s;
  }
  .player :global(.pointer.down .ring) {
    opacity: 1;
    transform: scale(1);
  }
  .compact .frame {
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
  }
  .compact {
    margin: 1.2rem 0 2rem;
  }
  .player :global(.ap-wrapper) {
    background: #16161e;
  }
</style>
