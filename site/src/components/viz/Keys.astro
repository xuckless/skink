---
// "No modes": the keys everyone already knows, pressed in turn.
import Window from './Window.astro';
const keys = [
  ['Ctrl', 'S', 'Saved'],
  ['Ctrl', 'C', 'Copied'],
  ['Ctrl', 'Z', 'Undone'],
  ['Ctrl', 'Q', 'Closed'],
];
---

<Window title="notes.md" label="Typing straight into a file, then Ctrl+S saves, Ctrl+C copies, Ctrl+Z undoes and Ctrl+Q quits.">
  <div class="line"><span class="typed">Just start typing</span><span class="caret"></span></div>
  <div class="keys">
    {
      keys.map(([m, k, said], i) => (
        <div class="key" style={`--i:${i}`}>
          <span class="cap">{m}</span>
          <span class="cap">{k}</span>
          <span class="said">{said}</span>
        </div>
      ))
    }
  </div>
</Window>

<style>
  .line {
    height: 1.6em;
    white-space: nowrap;
    display: flex;
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    width: 16ch;
    animation: type 10s steps(16, end) infinite;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.2em;
    margin-top: 0.2em;
    background: #7aa2f7;
    animation: blink 1s steps(1) infinite;
  }
  .keys {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
  }
  .cap {
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    background: #2a2f45;
    box-shadow: inset 0 -2px 0 #16161e;
    color: #a9b1d6;
    animation: press 10s infinite;
    animation-delay: calc(2s + var(--i) * 2s);
  }
  .said {
    flex-basis: 100%;
    text-align: center;
    font-family: var(--sk-sans);
    font-size: 12px;
    color: #7aa2f7;
    opacity: 0;
    animation: say 10s infinite;
    animation-delay: calc(2s + var(--i) * 2s);
  }
  @keyframes type {
    0% { width: 0; }
    18%, 100% { width: 16ch; }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes press {
    0% { transform: translateY(0); }
    2% { transform: translateY(2px); background: #7aa2f7; color: #16161e; box-shadow: none; }
    12% { transform: translateY(0); background: #7aa2f7; color: #16161e; }
    18%, 100% { background: #2a2f45; color: #a9b1d6; }
  }
  @keyframes say {
    0% { opacity: 0; transform: translateY(-3px); }
    3%, 16% { opacity: 1; transform: none; }
    20%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .said { opacity: 1; animation: none; }
    .cap, .typed, .caret { animation: none; }
  }
</style>
