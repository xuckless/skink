---
interface Props {
  chips?: string[];
  autofocus?: boolean;
  compact?: boolean;
}
const {
  chips = [
    'how do I exit',
    'set up Claude Code',
    'make the text bigger',
    'show hidden files',
    'edit over SSH',
    'split the screen',
    'copy to my clipboard',
  ],
  autofocus = false,
  compact = false,
} = Astro.props;
const id = `finder-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['finder', { compact }]} data-finder>
  <label for={id} class="label">What would you like to search?</label>
  <div class="box">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    <input
      id={id}
      type="search"
      role="combobox"
      aria-expanded="true"
      aria-controls={`${id}-list`}
      autocomplete="off"
      spellcheck="false"
      placeholder="A problem, a key, a command… e.g. “how do I quit”"
      autofocus={autofocus}
    />
    <kbd class="hint">/</kbd>
  </div>
  <ul class="results" id={`${id}-list`} role="listbox" data-results hidden></ul>
  {
    chips.length > 0 && (
      <div class="chips" aria-label="Popular questions">
        {chips.map((c) => (
          <button type="button" data-chip={c}>
            {c}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  import { initFinders } from '../scripts/finder';
  initFinders();
</script>

<style>
  .finder {
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    text-align: left;
  }
  .label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sk-fg-2);
    margin-bottom: 0.6rem;
  }
  .compact .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .box {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0 1rem;
    border-radius: 14px;
    background: var(--sk-bg-2);
    border: 1px solid var(--sk-line);
    color: var(--sk-muted);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .box:focus-within {
    border-color: var(--sk-blue);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sk-blue) 22%, transparent);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sk-fg);
    font: inherit;
    font-size: 1.08rem;
    padding: 0.95rem 0;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .hint {
    opacity: 0.7;
  }
  .results {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.35rem;
    border-radius: 14px;
    border: 1px solid var(--sk-line);
    background: var(--sk-bg-2);
    max-height: min(62vh, 34rem);
    overflow: auto;
  }
  .results :global(li) {
    margin: 0;
  }
  .results :global(a) {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--sk-fg);
  }
  .results :global([aria-selected='true'] a),
  .results :global(a:hover) {
    background: var(--sk-bg-3);
  }
  .results :global(.kind) {
    flex: none;
    width: 5.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0;
    text-align: center;
    border-radius: 6px;
    background: var(--sk-bg-3);
    color: var(--sk-blue);
    margin-top: 0.1rem;
  }
  .results :global(.k-key) { color: var(--sk-teal); }
  .results :global(.k-command) { color: var(--sk-purple); }
  .results :global(.k-article),
  .results :global(.k-compare) { color: var(--sk-orange); }
  .results :global(.k-manual) { color: var(--sk-muted); }
  .results :global(.body) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    min-width: 0;
  }
  .results :global(.title) {
    font-weight: 600;
  }
  .results :global(.keys) {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }
  .results :global(.plus) {
    color: var(--sk-muted);
    font-size: 0.8em;
  }
  .results :global(.ans) {
    flex-basis: 100%;
    color: var(--sk-fg-2);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .results :global(.empty) {
    padding: 0.8rem;
    color: var(--sk-fg-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.85rem;
  }
  .chips button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--sk-line);
    background: transparent;
    color: var(--sk-fg-2);
    cursor: pointer;
  }
  .chips button:hover {
    border-color: var(--sk-blue);
    color: var(--sk-fg);
  }
  @media (max-width: 40rem) {
    .results :global(.kind) {
      width: 4.6rem;
      font-size: 0.62rem;
    }
    .hint {
      display: none;
    }
  }
</style>
