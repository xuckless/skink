---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import Demo from '../components/Demo.astro';
import Keys from '../components/viz/Keys.astro';
import Tabs from '../components/viz/Tabs.astro';
import Ssh from '../components/viz/Ssh.astro';
import Agent from '../components/viz/Agent.astro';
import ref from '../data/reference.json';

const site = Astro.site!;
const title = 'Skink: a modeless code editor for the terminal';
const description =
  'Skink is a fast, modeless code editor for the terminal: familiar keys, mouse, language servers, git, AI agents and SSH. One binary for Linux, macOS and Windows.';
const canonical = new URL('/', site).href;
const image = new URL('/og.png', site).href;
const install = {
  unix: 'curl -fsSL https://skink.cc/install.sh | sh',
  windows: 'irm https://skink.cc/install.ps1 | iex',
  cargo: 'cargo install --git https://github.com/xuckless/skink skink',
};

const faqs: [string, string][] = [
  ['How do I exit Skink?', 'Press Ctrl+Q. It closes the tab, and quits on the last one. If something is unsaved, Skink asks first.'],
  ['Does Skink have modes like Vim?', 'No. You type to insert, select with Shift or the mouse, and save with Ctrl+S. F10 opens a menu bar that shows the common actions with their keys.'],
  ['Can I use Skink over SSH?', 'Yes. Run it on the server, or run skink ssh host:path and it copies itself over and forwards the ports your dev servers open. Copy reaches your local clipboard with OSC 52.'],
  ['Does the mouse work?', 'Yes, out of the box: click to place the cursor, drag to select, click tabs, scroll sideways on a trackpad, Alt+click for more cursors.'],
  ['Which AI agents work with Skink?', 'Any agent CLI runs in a terminal tab. Over the Agent Client Protocol, Skink also drives Claude Code, Gemini CLI, Codex, opencode, Goose and Antigravity from its prompt box and agent panel.'],
  ['Is it free?', `Yes. Skink is open source under MIT OR Apache-2.0. Version ${ref.version} is out. It is a young project, so expect rough edges.`],
];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': canonical + '#website',
      url: canonical,
      name: 'Skink',
      description,
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': canonical + '#app',
      name: 'Skink',
      description,
      url: canonical,
      image,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Code editor',
      operatingSystem: 'Linux, macOS, Windows',
      softwareVersion: ref.version,
      license: 'https://github.com/xuckless/skink/blob/main/LICENSE-MIT',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      downloadUrl: 'https://github.com/xuckless/skink/releases/latest',
      installUrl: new URL('/start/install/', site).href,
      softwareHelp: new URL('/docs/', site).href,
      codeRepository: 'https://github.com/xuckless/skink',
      author: { '@type': 'Person', name: 'xuckless', url: 'https://github.com/xuckless' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};

// Line icons, 24px grid.
const I = {
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5',
  git: 'M6 3v12M18 9a3 3 0 1 0 0-.01M6 21a3 3 0 1 0 0-.01M18 12c0 4-6 3-12 6',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4',
  cursors: 'M7 4v7M7 13v7M17 4v7M17 13v7',
  editor: 'M4 17l5-5-5-5M12 19h8',
  packages: 'M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8',
  remote: 'M3 5h18v10H3zM8 19h8M12 15v4',
  bug: 'M9 8h6a3 3 0 0 1 3 3v3a6 6 0 0 1-12 0v-3a3 3 0 0 1 3-3zM12 8V5M5 12H2M22 12h-3M5 18l-2 2M19 18l2 2',
};
const features: [keyof typeof I, string, string, string][] = [
  ['code', 'Language servers', 'Completion, hover, go to definition, rename and code actions, started for the language you open.', '/code/code-intelligence/'],
  ['git', 'Git', 'Gutter marks, stage a hunk from a peek, inline blame, a code review with comments and side-by-side diffs.', '/tools/git/'],
  ['search', 'Project search', 'Ripgrep-fast search and replace across files, plus structural search.', '/code/project-search/'],
  ['cursors', 'Multiple cursors', 'Ctrl+D adds the next match, Alt+click adds anywhere. One undo for all of them.', '/editing/multiple-cursors/'],
  ['bug', 'Debugger', 'Breakpoints, stepping and variables over the Debug Adapter Protocol.', '/code/debugger/'],
  ['editor', 'Your $EDITOR', 'git commit, crontab -e and your AI CLI open a lean Skink in about 2 ms.', '/tools/skink-as-editor/'],
  ['packages', 'Packages', 'More languages, language servers, themes and fonts with one command: skink --install kotlin.', '/customize/packages/'],
  ['remote', 'skink ssh', 'Runs the editor on the server over your own ssh and forwards the ports it opens.', '/remote/skink-ssh/'],
];

const compare = [
  ['', 'Skink', 'Neovim', 'nano', 'Zed'],
  ['Type right away, no modes', 'Yes', 'No', 'Yes', 'Yes'],
  ['Mouse by default', 'Yes', 'Yes', 'Opt-in', 'Yes'],
  ['Runs over plain SSH', 'Yes', 'Yes', 'Yes', 'No'],
  ['Language servers built in', 'Yes', 'With config', 'No', 'Yes'],
  ['AI agents in the editor', 'Yes', 'Plugins', 'No', 'Yes'],
  ['Plugins and extensions', 'Lua and packages', 'Huge', 'No', 'Yes'],
  ['Maturity', 'New', 'Decades', 'Decades', 'Stable'],
];

const footer: [string, [string, string][]][] = [
  ['Start', [['Install', '/start/install/'], ['Quick start', '/start/quick-start/'], ['Quit and save', '/start/exit-skink/'], ['All docs', '/docs/']]],
  ['Guides', [['AI agents', '/tools/ai-agents/'], ['Editing over SSH', '/remote/ssh-remote-editing/'], ['Mouse and trackpad', '/editing/mouse-and-trackpad/'], ['Settings', '/customize/configuration/']]],
  ['Reference', [['Keyboard shortcuts', '/reference/shortcuts/'], ['Commands', '/reference/commands/'], ['Manual', '/reference/manual/'], ['llms.txt', '/llms.txt']]],
  ['Compare', [['Skink vs Neovim', '/compare/neovim/'], ['Skink vs nano', '/compare/nano/'], ['Skink vs Zed', '/compare/zed/'], ['All comparisons', '/compare/']]],
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skink" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Skink, a modeless code editor in the terminal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@xuckless" />
    <meta name="theme-color" content="#15161e" />
    <script is:inline>
      try {
        const t = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href="/" aria-label="Skink home">
        <img class="logo dark" src="/logo-dark.svg" alt="Skink" width="96" height="32" />
        <img class="logo light" src="/logo-light.svg" alt="Skink" width="96" height="32" />
      </a>
      <nav aria-label="Main">
        <a href="/docs/">Docs</a>
        <a href="/reference/shortcuts/">Shortcuts</a>
        <a href="https://github.com/xuckless/skink" class="gh" aria-label="Skink on GitHub">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
        </a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap">
        <h1>The code editor for your terminal, without modes</h1>
        <p class="lede">
          Type, click, <kbd>Ctrl</kbd>+<kbd>S</kbd>. Language servers, git, a real shell and your AI agent, in one small
          binary that runs anywhere you can SSH.
        </p>

        <div class="install" data-install>
          <div class="os" role="tablist" aria-label="Your system">
            <button type="button" role="tab" aria-selected="true" data-os="unix">Linux and macOS</button>
            <button type="button" role="tab" aria-selected="false" data-os="windows">Windows</button>
            <button type="button" role="tab" aria-selected="false" data-os="cargo">Cargo</button>
          </div>
          <div class="cmd">
            <code data-cmd data-unix={install.unix} data-windows={install.windows} data-cargo={install.cargo}>{install.unix}</code>
            <button type="button" class="copy" data-copy aria-label="Copy the install command">Copy</button>
          </div>
        </div>
        <p class="after">
          No sudo needed. Then run <code>skink .</code> &nbsp;·&nbsp; <a href="/start/install/">Other ways to install</a> &nbsp;·&nbsp;
          v{ref.version}, free and open source
        </p>
      </section>

      <section class="watch wrap" aria-label="Recorded demo">
        <Demo />
      </section>

      <section class="story wrap">
        <div class="row">
          <div class="say">
            <h2>Keys you already know</h2>
            <p>
              There is no insert mode to enter and no command to remember to leave. Copy, paste, undo and save work the way
              they do everywhere else.
            </p>
            <a href="/start/quick-start/">Quick start</a>
          </div>
          <div class="show"><Keys /></div>
        </div>

        <div class="row flip">
          <div class="say">
            <h2>Everything is a tab</h2>
            <p>Files, shells, diffs, your AI agent and the help sit in one tab bar. <kbd>F12</kbd> flips between the file and the shell.</p>
            <a href="/tools/terminal-tabs/">Terminal tabs</a>
          </div>
          <div class="show"><Tabs /></div>
        </div>

        <div class="row">
          <div class="say">
            <h2>The same editor over SSH</h2>
            <p>Copy a single binary, no sudo, no GUI. What you copy on the server lands on your own clipboard.</p>
            <a href="/remote/ssh-remote-editing/">Editing over SSH</a>
          </div>
          <div class="show"><Ssh /></div>
        </div>

        <div class="row flip">
          <div class="say">
            <h2>Bring your own AI agent</h2>
            <p>
              Claude Code, Gemini CLI, Codex, opencode and Goose run in a tab or drive the editor directly. Their edits arrive as
              a diff you keep or drop.
            </p>
            <a href="/tools/ai-agents/">Set up an agent</a>
          </div>
          <div class="show"><Agent /></div>
        </div>
      </section>

      <section class="numbers wrap" aria-labelledby="num-h">
        <h2 id="num-h">Small and quick</h2>
        <dl>
          <div><dt>Binary size</dt><dd>~23 MB</dd></div>
          <div><dt>Memory when idle</dt><dd>~10 MB</dd></div>
          <div><dt>To the first frame</dt><dd>2–4 ms</dd></div>
        </dl>
      </section>

      <section class="features wrap" aria-labelledby="feat-h">
        <h2 id="feat-h">An IDE’s worth, in the terminal</h2>
        <ul>
          {
            features.map(([icon, name, body, href]) => (
              <li>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path d={I[icon]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3><a href={href}>{name}</a></h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="compare wrap" aria-labelledby="cmp-h">
        <h2 id="cmp-h">How it compares</h2>
        <p class="sub">Skink is young. Neovim and nano have decades on it, and Zed is a polished GUI.</p>
        <div class="scroll">
          <table>
            <thead>
              <tr>{compare[0].map((c, i) => <th scope="col" class:list={{ us: i === 1 }}>{c}</th>)}</tr>
            </thead>
            <tbody>
              {
                compare.slice(1).map((row) => (
                  <tr>
                    {row.map((c, i) =>
                      i === 0 ? <th scope="row">{c}</th> : <td class:list={{ us: i === 1, no: c === 'No' }}>{c}</td>,
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="sub"><a href="/compare/">Full comparisons</a></p>
      </section>

      <section class="faq wrap" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions</h2>
        {
          faqs.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </section>

      <section class="cta wrap">
        <h2>Try it in thirty seconds</h2>
        <p>Install, open a folder, and press <kbd>Ctrl</kbd>+<kbd>Q</kbd> when you are done.</p>
        <div class="buttons">
          <a class="btn primary" href="/start/install/">Install Skink</a>
          <a class="btn" href="/docs/">Read the docs</a>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <nav aria-label="Footer">
        {
          footer.map(([h, links]) => (
            <div>
              <h2>{h}</h2>
              {links.map(([label, href]) => <a href={href}>{label}</a>)}
            </div>
          ))
        }
      </nav>
      <p class="legal">
        Skink is MIT OR Apache-2.0, built by <a href="https://github.com/xuckless">xuckless</a>. Key bindings and config formats
        come from <a href="https://micro-editor.github.io">Micro</a>.
      </p>
    </footer>

    <script>
      const box = document.querySelector<HTMLElement>('[data-install]')!;
      const code = box.querySelector<HTMLElement>('[data-cmd]')!;
      const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-os]')];
      const pick = (b: HTMLButtonElement) => {
        tabs.forEach((o) => o.setAttribute('aria-selected', String(o === b)));
        code.textContent = code.dataset[b.dataset.os!]!;
      };
      tabs.forEach((b) => b.addEventListener('click', () => pick(b)));
      if (/Win/.test(navigator.platform)) pick(tabs[1]);
      const copy = box.querySelector<HTMLButtonElement>('[data-copy]')!;
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          copy.textContent = 'Copied';
        } catch {
          getSelection()?.selectAllChildren(code);
          copy.textContent = 'Selected';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1600);
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--sk-bg);
    color: var(--sk-fg);
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--sk-bg);
    font-family: var(--sk-sans);
    font-size: 17px;
    line-height: 1.6;
    overflow-x: hidden;
  }
  a {
    color: var(--sk-blue);
    text-underline-offset: 3px;
  }
  code {
    font-family: var(--sk-mono);
    font-size: 0.88em;
  }
  h1,
  h2,
  h3 {
    color: var(--sk-fg);
    line-height: 1.2;
    font-weight: 650;
    margin: 0;
  }
  .logo.light,
  [data-theme='light'] .logo.dark {
    display: none;
  }
  [data-theme='light'] .logo.light {
    display: block;
  }
</style>

<style>
  .wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--sk-bg-2);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.1rem 1.25rem;
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .top nav a {
    color: var(--sk-fg-2);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .top nav a:hover {
    color: var(--sk-fg);
  }
  .gh {
    display: flex;
  }

  .hero {
    padding-top: clamp(3rem, 9vw, 6.5rem);
    padding-bottom: 2.5rem;
    max-width: 52rem;
    text-align: center;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.9rem);
    line-height: 1.08;
    font-weight: 700;
    text-wrap: balance;
  }
  .lede {
    margin: 1.4rem auto 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    color: var(--sk-fg-2);
    text-wrap: pretty;
  }
  .install {
    margin: 2.2rem auto 0;
    max-width: 38rem;
    text-align: left;
  }
  .os {
    display: flex;
    gap: 1.2rem;
    margin-bottom: 0.4rem;
    padding-left: 0.2rem;
  }
  .os button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.3rem 0;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--sk-muted);
    cursor: pointer;
  }
  .os button[aria-selected='true'] {
    color: var(--sk-fg);
    border-bottom-color: var(--sk-blue);
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1rem;
    border-radius: 10px;
    background: var(--sk-bg-3);
  }
  .cmd code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.92rem;
    scrollbar-width: none;
  }
  .copy {
    flex: none;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 7px;
    background: var(--sk-blue);
    color: var(--sk-blue-ink);
    cursor: pointer;
  }
  .after {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: var(--sk-muted);
  }

  .watch {
    max-width: 64rem;
    padding-bottom: 2rem;
  }

  .story {
    padding-top: clamp(3rem, 8vw, 6rem);
    display: grid;
    gap: clamp(4rem, 10vw, 7.5rem);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .row.flip .say {
    order: 2;
  }
  .say {
    max-width: 28rem;
  }
  .say h2,
  .numbers h2,
  .features h2,
  .compare h2,
  .faq h2,
  .cta h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
  }
  .say p {
    margin: 1rem 0 1.1rem;
    color: var(--sk-fg-2);
  }
  .say a {
    font-weight: 600;
    text-decoration: none;
  }
  .say a::after {
    content: ' →';
  }
  .show {
    display: flex;
    justify-content: center;
  }

  .numbers {
    padding-top: clamp(5rem, 11vw, 8rem);
  }
  .numbers dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2rem 0 0;
  }
  .numbers dl div {
    display: flex;
    flex-direction: column-reverse;
  }
  .numbers dt {
    color: var(--sk-muted);
    font-size: 0.95rem;
  }
  .numbers dd {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 650;
    color: var(--sk-fg);
    font-variant-numeric: tabular-nums;
  }

  .features {
    padding-top: clamp(5rem, 11vw, 8rem);
  }
  .features ul {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.4rem 2rem;
  }
  .features svg {
    color: var(--sk-blue);
  }
  .features h3 {
    margin-top: 0.7rem;
    font-size: 1.05rem;
  }
  .features h3 a {
    color: inherit;
    text-decoration: none;
  }
  .features h3 a:hover {
    color: var(--sk-blue);
  }
  .features p {
    margin: 0.4rem 0 0;
    color: var(--sk-fg-2);
    font-size: 0.95rem;
  }

  .compare {
    padding-top: clamp(5rem, 11vw, 8rem);
  }
  .sub {
    color: var(--sk-fg-2);
    margin: 0.8rem 0 0;
  }
  .scroll {
    margin-top: 1.8rem;
    overflow-x: auto;
  }
  table {
