[4.6044, "o", "48;2;26;27;38m 13 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#                    opens the editor\u001b[15;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 14 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# x, exec <command> = run command (the rest of the line) using shell\u001b[16;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 15 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# b, break = stop here (continue rebase later with 'git rebase --continue')\u001b[17;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 16 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# d, drop <commit> = remove commit\u001b[18;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 17 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# l, label <label> = label current HEAD with a name\u001b[19;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 18 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# t, reset <label> = reset HEAD to a label\u001b[20;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 19 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# m, merge [-C <commit> | -c <commit>] <label> [# <oneline>]\u001b[21;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 20 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#         create a merge commit using"]
[4.6044, "o", " the original merge commit's\u001b[22;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 21 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#         message (or the oneline, if no original merge commit was\u001b[23;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 22 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#         specified); use -c <commit> to reword the commit message\u001b[24;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 23 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# u, update-ref <ref> = track a placeholder for the <ref> to be updated\u001b[25;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 24 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#                       to this position in the new commits. The <ref> is\u001b[26;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 25 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#                       updated at the end of the rebase\u001b[27;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 26 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m#\u001b[28;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 27 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m# These lines can be re-ordered; they are executed from top to bottom.\u001b[29;1H\u001b[23m\u001b[38;2;169;177"]
