[2.4627, "o", "\u001b[1;1H\u001b[38;2;169;177;214;48;2;22;22;30m  main.rs                  \u001b[1m\u001b[38;2;22;22;30;48;2;122;162;247m  settings.json           ×\u001b[2;1H\u001b[22m\u001b[38;2;59;66;97;48;2;41;46;66m \u001b[1m\u001b[38;2;122;162;247;48;2;41;46;66m 1\u001b[22m\u001b[38;2;59;66;97;48;2;41;46;66m \u001b[3m\u001b[38;2;86;95;137;48;2;41;46;66m// ---- Skink AI reference (rewritten when :settings opens; your values are below) ----\u001b[23m\u001b[38;2;192;202;245;48;2;41;46;66m                  \u001b[38;2;122;162;247;48;2;41;46;66m▐\u001b[3;5H\u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// \"ai.agent\": which coding agent the AI box (Ctrl-G) and :agent talk to.\u001b[4;5H//   \"auto\"  the first available, in this order:\u001b[5;5H//   \"claude\"     Claude Code — via npx (@zed-industries/claude-code-acp)\u001b[6;5H//                also \"claude-code\", \"claude-code-acp\", \"anthropic\"\u001b[7;5H//   \"gemini\"     Gemini CLI — not found: needs `npm i -g @google/gemini-cli`\u001b[8;5H//                also \"gemini-cli\", \"google-gemini\"\u001b[23m\u001b[38;2;192;202;245;48;2;26;27;38m    \u001b[9;5H\u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m//   \"opencode\"   opencode — not found: needs opencode on PATH (opencode.ai)\u001b[10;5H//                also \"open-code\"\u001b[11;5H//   \"goose\"      Goose — not found: needs goose on PATH (block.github.io/goose)\u001b[12;5H//    \u001b[12;12H \u001b[12;14H    \u001b[12;19H   \u001b[12;23Halso \"goose-cli\"\u001b[23m\u001b[38;2;192;202;245;48;2;26;27;38m              \u001b[13;5H\u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m//   \"antigravity\" Antigravity — not found: needs Antigravity's `agy` on PATH\u001b[14;5H//                also \"agy\"\u001b[15;5H//   \"codex\"      Codex — via npx (@zed-industries/codex-acp)\u001b[16;5H//                also \"codex-acp\", \"openai-codex\", \"codex-cli\"\u001b[17;5H//   [\"my-agent\", \"--acp\"]  any command that speaks ACP on stdio\u001b[18;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 17 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// \"ai.model\": \"default\" or a model the agent offers; loose names work\u001b[19;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 18 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m//   (\"opus 5.5\", \"opus5.5\", \"claude-opus-5-5\"). :model lists the offered ones.\u001b[20;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 19 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// \"ai.effort\": \"default\", \"low\", \"medium\", \"high\" or \"max\".\u001b[21;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 20 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m//   Claude Code: thinking budget of 4k / 10k / 20k / 32k tokens. Other agents:\u001b[22;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 21 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m//   their reasoning-level option, when they offer one over ACP.\u001b[23;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 22 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// Per mode: \"ai.model.rewrite\", \"ai.effort.ask\", ... (rewrite, ask, search, implement)\u001b[24;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 23 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// Saving a change to these runs a one-line test chat (in a throwaway folder,\u001b[25;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 24 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// deleted afterwards). :agents shows the result; :agents check reruns it.\u001b[26;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 25 \u001b[3m\u001b[38;2;86;95;137;48;2;26;27;38m// ---- end of Skink AI reference ----\u001b[27;1H\u001b[23m\u001b[38;2;59;66;97;48;2;26;27;38m 26 \u001b[38;2;192;202;245;48;2;26;27;38m{\u001b[28;1H\u001b[38;2;59;66;97;48;2;26;27;38m 27 \u001b[38;2;42;47;69;48;2;26;27;38m│\u001b[28;9H\u001b[38;2;115;218;202;48;2;26;27;38m\"tabsize\"\u001b[38;2;192;202;245;48;2;26;27;38m:\u001b[28;20H\u001b[38;2;255;158;100;48;2;26;27;38m4\u001b[38;2;192;202;245;48;2;26;27;38m,\u001b[29;1H\u001b[38;2;59;66;97;48;2;26;27;38m 28 \u001b[38;2;42;47;69;48;2;26;27;38m│\u001b[29;9H\u001b[38;2;115;218;202;48;2;26;27;38m\"icons\"\u001b[38;2;192;202;245;48;2;26;27;38m:\u001b[29;18H\u001b[38;2;158;206;106;48;2;26;27;38m\"auto\"\u001b[38;2;192;202;245;48;2;26;27;38m,\u001b[30;2H\u001b[38;2;122;162;247;48;2;22;22;30m\u001b[1m\u001b[38;2;22;22;30;48;2;122;162;247m EDIT \u001b[22m\u001b[38;2;122;162;247;48;2;22;22;30m\u001b[38;2;169;177;214;48;2;22;22;30m \u001b[30;12H/home/demo/.config/skink/settings.json\u001b[30;91H\u001b[38;2;86;95;137;48;2;22;22;30mLF \u001b[38;2;122;162;247;48;2;22;22;30m json \u001b[38;2;158;206;106;48;2;22;22;30m \u001b[38;2;122;162;247;48;2;22;22;30m\u001b[1m\u001b[38;2;22;22;30;48;2;122;162;247m 1:1 \u001b[22m\u001b[38;2;122;162;247;48;2;22;22;30m\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25h\u001b[2;"]
